---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <p>© {year} {site.name}</p>
    <p>Built with <a href="https://astro.build">Astro</a></p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }

  p {
    margin: 0;
  }
</style>
