---
// Home / Gallery / About nav and the Instagram and LinkedIn buttons, top right of the canvas.
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { u, at } from '../utils/canvas';
import { withBase } from '../utils/url';
import instagramIcon from '../assets/work/icon-instagram.png';
import linkedinIcon from '../assets/work/icon-linkedin.png';

interface Props {
  // On the homepage itself, "Home" is plain text rather than a link.
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
---

<nav aria-label="Main" class="nav-wrap" style={at(630, 52, 200, 18)}>
  {site.nav.map((item, i) => {
    const style = `left:${u([0, 75, 159][i])}`;
    return item === 'Home' && !isHome ? (
      <a class="t-nav" href={withBase('/')} style={style}>{item}</a>
    ) : (
      <span class="t-nav" style={style} aria-current={item === 'Home' ? 'page' : undefined}>{item}</span>
    );
  })}
</nav>

<a class="social" href={site.links.instagram} target="_blank" rel="noopener noreferrer" style={at(861, 38, 42, 41.59)}>
  <Image src={instagramIcon} alt="" width={120} widths={[60, 120]} sizes="3vw" style={at(6, 6, 30, 30)} />
  <span class="visually-hidden">Instagram (opens in a new window)</span>
</a>
<a class="social" href={site.links.linkedin} target="_blank" rel="noopener noreferrer" style={at(915, 38, 42, 41.59)}>
  <Image src={linkedinIcon} alt="" width={112} widths={[56, 112]} sizes="3vw" style={at(8, 7.75, 28, 25.76)} />
  <span class="visually-hidden">LinkedIn (opens in a new window)</span>
</a>

<style>
  .t-nav {
    position: absolute;
    top: 0;
    font-size: calc(13 * var(--u));
    line-height: calc(18 * var(--u));
    font-weight: 702;
    letter-spacing: calc(-0.2 * var(--u));
    white-space: nowrap;
    text-decoration: none;
  }

  a.t-nav:hover {
    text-decoration: underline;
  }

  .nav-wrap {
    display: block;
  }

  .social {
    display: block;
    background: var(--tile);
    border-radius: calc(10 * var(--u));
  }

  .social img {
    position: absolute;
    object-fit: cover;
  }
</style>
