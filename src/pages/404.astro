---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
---

<BaseLayout title="Page not found">
  <div class="canvas-wrap">
    <main class="canvas" style="--canvas-height: 600">
      <a class="t-name" href={withBase('/')}>{site.name}</a>
      <h1 class="t-heading">Page not found</h1>
      <p class="t-strong">This page doesn't exist. <a href={withBase('/')}>Back home</a></p>
    </main>
  </div>
</BaseLayout>

<style>
  .t-name {
    left: calc(67 * var(--u));
    top: calc(49 * var(--u));
    font-size: calc(29 * var(--u));
    line-height: calc(25 * var(--u));
    font-weight: 681;
    text-transform: uppercase;
    text-decoration: none;
  }

  .t-heading {
    left: calc(67 * var(--u));
    top: calc(140 * var(--u));
    font-size: calc(19 * var(--u));
    line-height: calc(19 * var(--u));
    font-weight: 702;
    letter-spacing: calc(-0.2 * var(--u));
  }

  .t-strong {
    left: calc(67 * var(--u));
    top: calc(170 * var(--u));
    font-size: calc(10 * var(--u));
    line-height: calc(18 * var(--u));
    font-weight: 702;
    letter-spacing: calc(-0.2 * var(--u));
  }
</style>
