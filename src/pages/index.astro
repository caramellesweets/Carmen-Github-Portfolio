---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import { site, education, experience, expertise, projects } from '../data/site';
import { u, at, vw } from '../utils/canvas';
import { withBase } from '../utils/url';

const GRID = { x: 67, y: 616, colStep: 304, rowStep: 202, w: 282, h: 169 };
const tiles = projects.map((project, i) => ({
  ...project,
  x: GRID.x + (i % 3) * GRID.colStep,
  y: GRID.y + Math.floor(i / 3) * GRID.rowStep,
}));
---

<BaseLayout>
  <div class="canvas-wrap">
    <main class="canvas">
      <!-- Header -->
      <h1 class="t-name" style={at(67, 49, 511)}>{site.name}</h1>

      <TopNav isHome />

      <!-- Hero panel -->
      <div class="hero" aria-hidden="true" style={at(67, 98, 890, 261)}></div>
      <div class="hero" aria-hidden="true" style={at(488, 240, 469, 120)}></div>

      <!-- Education / Experience -->
      <h2 class="t-heading" style={at(67, 378, 480)}>Education</h2>
      <p class="t-strong" style={at(67, 405, 435)}>{education.school}</p>
      <p class="t-small" style={at(67, 423, 435)}>{education.detail}</p>

      <h2 class="t-heading" style={at(544, 378, 480)}>Experience</h2>
      <p class="t-strong" style={at(544, 405, 480)}>{experience.role}</p>
      <p class="t-small" style={at(544, 423, 435)}>{experience.detail}</p>

      <!-- Creative Expertise -->
      <h2 class="t-heading" style={at(67, 459, 480)}>Creative Expertise</h2>
      <ul class="t-list" style={at(67, 489, 435)}>
        {expertise.map((item) => <li>{item}</li>)}
      </ul>

      <!-- Featured Work -->
      <h2 class="t-heading" style={at(67, 571, 480)}>Featured Work</h2>
      {tiles.map((tile) => {
        const Tag = tile.href ? 'a' : 'figure';
        return (
          <Tag class:list={['tile', { 'tile-link': tile.href }]} href={tile.href && withBase(tile.href)} style={at(tile.x, tile.y, GRID.w, GRID.h + 18)}>
            <Image
              src={tile.image}
              alt={tile.title}
              width={1128}
              widths={[282, 564, 846, 1128]}
              sizes={vw(GRID.w)}
              style={`height:${u(GRID.h)};object-position:${tile.position ?? '50% 50%'}`}
            />
            <span class="caption t-strong">{tile.title}</span>
          </Tag>
        );
      })}
    </main>
  </div>
</BaseLayout>

<style>
  .hero {
    background: var(--hero);
    border-radius: calc(20 * var(--u));
  }

  .tile {
    display: block;
    margin: 0;
    text-decoration: none;
  }

  .tile img {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: calc(10 * var(--u));
  }

  .tile .caption {
    display: block;
    white-space: nowrap;
  }

  .tile-link img {
    transition: opacity 0.15s;
  }

  .tile-link:hover img {
    opacity: 0.85;
  }

  .tile-link:focus-visible {
    outline-offset: calc(3 * var(--u));
    border-radius: calc(10 * var(--u));
  }
</style>
