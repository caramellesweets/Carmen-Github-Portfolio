---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, about, projects } from '../data/site';
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{site.role} · {site.location}</p>
      <h1>Hi, I'm {site.name.split(' ')[0]}.<br /><span>{site.tagline}</span></h1>
      <p class="intro">{site.intro}</p>
      <div class="actions">
        <a class="button button-primary" href="#projects">See my work</a>
        <a class="button button-ghost" href={site.links.github} target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section id="about" class="section">
    <div class="container about">
      <div>
        <p class="eyebrow">About</p>
        <h2 class="section-title">A little about me</h2>
      </div>
      <div>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <h3 class="skills-heading">Tools I use</h3>
        <ul class="skills">
          {about.skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h2 class="section-title">Selected work</h2>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container contact">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Let's work together</h2>
      <p class="contact-text">
        I'm open to new opportunities and collaborations. The best way to reach me is by email.
      </p>
      <a class="button button-primary" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="socials">
        <li><a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(4rem, 12vw, 8rem) 0 clamp(3.5rem, 10vw, 6rem);
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.25rem);
    max-width: 18ch;
  }

  h1 span {
    color: var(--muted);
    font-weight: 400;
  }

  .intro {
    max-width: 38rem;
    margin: 1.5rem 0 2rem;
    font-size: 1.15rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about {
    display: grid;
    gap: 1rem 3rem;
  }

  .about p {
    margin: 0 0 1rem;
  }

  .skills-heading {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    margin: 1.75rem 0 0.75rem;
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skills li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }

  .contact {
    text-align: center;
  }

  .contact .section-title {
    margin-bottom: 1rem;
  }

  .contact-text {
    max-width: 32rem;
    margin: 0 auto 2rem;
    color: var(--muted);
  }

  .contact .button {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
